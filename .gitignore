# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.vite/

# Environment variables — NEVER commit secrets
.env
.env.local
.env.*.local
.env.production

# Local dev Postgres self-signed CA cert (machine-specific, never commit)
.dev-pg-ca.crt

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# Claude Code — local-only settings (machine/session-specific permission
# allowlists), never shared. launch.json (dev server config) IS committed.
.claude/settings.local.json

# Temp / cache
.cache/
.parcel-cache/
*.tsbuildinfo

# Uploaded files (handled by cloud storage in prod)
uploads/

# Desktop preview copy — not source of truth
# (source is this folder; preview is on Desktop)

# Root-level debug / maintenance scripts — never commit these
check_db.js
render_test.cjs
upload_payroll.js
compare_payroll.js
patch_billing.js
patch_server.py
debug_*.js
fix_*.js
apply_*.js
gen_upload_*.py
preview_server.js

# Scratch / temp files
*.local.js
*.tmp
*.bak
sms_test.ps1

# Production database dumps (S0A) — local only, never commit
backups/

# Local payslip QA artifacts (PDFs/HTML from test-run script)
audit/payslip-test-run-july/

# Client data exports / reference attachments — never commit real PII or client scripts
Attachments/
/*.xlsx
/*.xls

# Contact/focal dry-run dumps (employee emails and phones)
audit/cutover/wafi_contact_dryrun_*

