# =========================================================================
# ASIL HCM — Backend Environment Variables Template
# Repository: shezad/ASILHCM (BPOFMSystem)
#
# SETUP INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in every value marked [REQUIRED] before starting the server.
#   3. Values marked [LOCAL ONLY] are safe dev defaults — do NOT use in prod.
#   4. Values marked [OPTIONAL] disable a feature if omitted; server still starts.
#   5. NEVER commit .env to git. It is already in .gitignore.
#
# For production values, refer to the Render dashboard environment panel.
# Authoritative variable list: SYSTEM_BLUEPRINT.md Section 6.
# =========================================================================


# ---------------------------------------------------------------------------
# SECTION 1 — Server
# ---------------------------------------------------------------------------

# Port the Express server listens on locally.
# Render overrides this automatically in production.
PORT=3000                                         # [LOCAL ONLY]

# Controls cookie security flags and startup behaviour.
# Must be set to 'production' on Render. Never set to 'production' locally.
NODE_ENV=development                              # [LOCAL ONLY]

# Local frontend dev server address. Render sets this to the live frontend URL.
# Used for CORS policy and the OAuth redirect target.
FRONTEND_URL=http://localhost:5173                # [LOCAL ONLY]

# Local backend address. Used to construct the Google OAuth callback URL.
BACKEND_URL=http://localhost:3000                 # [LOCAL ONLY]

# Controls which email domain is allowed to log in via Google OAuth.
# Do NOT change from asil.com.pk without explicit authorisation.
ALLOWED_DOMAIN=asil.com.pk                        # [OPTIONAL — defaults to asil.com.pk]


# ---------------------------------------------------------------------------
# SECTION 2 — Database (CRITICAL)
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
#
# LOCAL DEV OPTIONS (choose one):
#   A) Local Postgres:  postgres://postgres:password@localhost:5432/asil_hcm_dev
#   B) Neon dev branch: get a fresh branch URL from Neon console — NEVER use main/prod branch
#
# WARNING: Do NOT paste the production DATABASE_URL here.
# A mistake here will run your dev migrations against 500 live employee records.
DATABASE_URL=postgres://localhost:5432/asil_hcm_dev   # [REQUIRED]


# ---------------------------------------------------------------------------
# SECTION 3 — Security & Session Management (CRITICAL)
# ---------------------------------------------------------------------------

# Secret used to sign and verify all JWT tokens.
# In production this MUST be a cryptographically random 64+ character string.
# If this is missing on Render, the server will crash on startup (by design).
# Local dev value below is intentionally weak — acceptable ONLY locally.
JWT_SECRET=dev_local_jwt_secret_minimum_64_chars_replace_in_prod   # [REQUIRED]

# Secret used to encrypt the Express session cookie during the OAuth handshake.
# Falls back to JWT_SECRET if not set, but setting it explicitly is preferred.
SESSION_SECRET=dev_local_session_cookie_encryption_key_hash         # [REQUIRED]

# Password required to unlock a bill that has already been marked as Paid.
# If not set, the unlock endpoint returns 503. Feature is effectively disabled.
BILLS_UNLOCK_PASSWORD=dev_local_unlock_password                     # [OPTIONAL]

# Password required to reset/wipe payroll data for a month.
# If not set, the payroll reset endpoint is disabled.
PAYROLL_RESET_PASSWORD=dev_local_payroll_reset_password             # [OPTIONAL]


# ---------------------------------------------------------------------------
# SECTION 4 — Google OAuth 2.0 (CRITICAL)
# ---------------------------------------------------------------------------

# Create a dedicated OAuth 2.0 client in Google Cloud Console for local dev.
# Set the authorised redirect URI to: http://localhost:3000/auth/google/callback
# Do NOT reuse the production OAuth client credentials for local development.
GOOGLE_CLIENT_ID=your_dev_google_oauth_client_id.apps.googleusercontent.com   # [REQUIRED]
GOOGLE_CLIENT_SECRET=your_dev_google_oauth_client_secret                       # [REQUIRED]


# ---------------------------------------------------------------------------
# SECTION 5 — Email: Resend (Transactional / Payslip Emails)
# ---------------------------------------------------------------------------

# API key for Resend (https://resend.com) — used for bulk payslip delivery.
# If omitted, the /api/payroll/email-payslips endpoint returns a 503 error.
# Safe to leave blank for local dev unless testing email flows.
RESEND_API_KEY=                                   # [OPTIONAL]

# The "From" address shown on all outbound emails sent via Resend.
SMTP_FROM=ASIL HR <hr@asil.com.pk>               # [OPTIONAL — defaults to this value]


# ---------------------------------------------------------------------------
# SECTION 6 — Email: Gmail OAuth (Claims Listener)
# ---------------------------------------------------------------------------

# These power the IMAP-based email claims ingestion service (wafiClaimsService.js).
# Required only if you are testing the claims inbox polling feature locally.
# Leave blank to disable the claims listener without affecting other features.
GMAIL_USER=                                       # [OPTIONAL]
GMAIL_CLIENT_ID=                                  # [OPTIONAL]
GMAIL_CLIENT_SECRET=                              # [OPTIONAL]
GMAIL_REFRESH_TOKEN=                              # [OPTIONAL]

# Separate inbox credentials used by the IMAP CLAIMS_EMAIL listener.
CLAIMS_EMAIL_USER=                                # [OPTIONAL]
CLAIMS_EMAIL_HOST=imap.gmail.com                  # [OPTIONAL — defaults to imap.gmail.com]
CLAIMS_POLL_INTERVAL_MS=300000                    # [OPTIONAL — defaults to 5 minutes]


# ---------------------------------------------------------------------------
# SECTION 7 — SMS: Jazz CMT Gateway
# ---------------------------------------------------------------------------

# Jazz CMT API credentials. The server IP must be whitelisted with Jazz CMT
# before these will function. Leave blank for local dev (SMS calls will fail
# gracefully with a 503 response — no data will be corrupted).
#
# SECURITY: These were previously hardcoded in server.js. They must now be
# provided as env vars. If absent, the SMS endpoint will explicitly return an
# error rather than fall back to any hardcoded value.
JAZZ_SMS_USER=                                    # [OPTIONAL — SMS disabled if blank]
JAZZ_SMS_PASS=                                    # [OPTIONAL — SMS disabled if blank]
JAZZ_SMS_MASK=ALLIED SERV                         # [OPTIONAL — defaults to ALLIED SERV]


# ---------------------------------------------------------------------------
# SECTION 8 — AI: OpenAI (OCR)
# ---------------------------------------------------------------------------

# OpenAI API key for GPT-4o Vision used by the Katcha bill OCR feature.
# If not set, the /api/bills/ocr endpoint returns a 503 error.
# Leave blank for local dev unless specifically testing the OCR flow.
OPENAI_API_KEY=                                   # [OPTIONAL — OCR disabled if blank]


# ---------------------------------------------------------------------------
# SECTION 9 — Xero Integration (Stub — Not Yet Active)
# ---------------------------------------------------------------------------

# Xero OAuth 2.0 credentials for the future real Xero integration.
# Currently a stub — these variables are read but no real API calls are made.
# Safe to leave blank. Document any changes in SYSTEM_BLUEPRINT.md Section 9.
XERO_CLIENT_ID=                                   # [OPTIONAL — Xero stub only]
XERO_CLIENT_SECRET=                               # [OPTIONAL — Xero stub only]
XERO_REDIRECT_URI=http://localhost:3000/api/xero/callback   # [OPTIONAL]


# ---------------------------------------------------------------------------
# SECTION 10 — Execution Environment Flag
# ---------------------------------------------------------------------------

# Signals to taxEngine.js and wafiClaimsService.js that this is a safe local
# sandbox. Set to 'local_sandbox' for dev. Leave unset (or set to 'production')
# on Render. Future test harness hooks will read this variable.
EXECUTION_ENV=local_sandbox                       # [LOCAL ONLY]
